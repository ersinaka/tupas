# Public site URL (no trailing slash). Used for canonical, OG, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email delivery (provider-independent)
# Supported: webhook | smtp | log (log only in non-production)
EMAIL_PROVIDER=
EMAIL_FROM=noreply@example.com
EMAIL_TO=info@example.com

# Webhook provider (recommended until SMTP connector is wired)
EMAIL_WEBHOOK_URL=
EMAIL_API_KEY=

# SMTP (optional; current build fails closed unless a connector is enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
